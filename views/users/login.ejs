<% layout("layouts/boilerplate") %>
    <div class="row mt-3">
        <div class="col-8 offset-2">
            <h1 class="text-center mt-3">Welcome back! Log in to Stayora</h1>
            <form action="/login" method="post" class="needs-validation mt-3" novalidate>

                <div class="mb-3">
                    <label for="username" class="form-label">Username</label>
                    <input name="username" placeholder="Enter your username" type="text" class="form-control" required
                        id="username">
                    <div class="valid-feedback">Please enter the correct username</div>
                    <div class="invalid-feedback">Please enter the username</div>
                </div>



                <div class="mb-3">
                    <label for="password" class="form-label">Password</label>
                    <input name="password" placeholder="Enter your password" type="password" class="form-control"
                        required id="password">
                    <div class="invalid-feedback">Please enter correct password</div>
                </div>

                <button class="btn btn-success mb-3">Login</button>

            </form>
        </div>
    </div>